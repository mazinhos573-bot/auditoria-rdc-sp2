```html
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Auditoria RDC-SP2</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 20px;
      font-family: Arial, sans-serif;
      background: #f1f5f9;
      color: #1e293b;
    }
    .container {
      max-width: 900px;
      margin: auto;
    }
    header {
      background: #123b65;
      color: white;
      padding: 24px;
      border-radius: 12px;
      margin-bottom: 20px;
    }
    h1 { margin: 0 0 8px; }
    .card {
      background: white;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px #00000010;
    }
    label {
      display: block;
      margin: 12px 0 6px;
      font-weight: bold;
    }
    input, select, textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid #cbd5e1;
      border-radius: 7px;
      font-size: 16px;
    }
    textarea { min-height: 90px; }
    button {
      border: 0;
      border-radius: 7px;
      padding: 12px 16px;
      margin-top: 14px;
      cursor: pointer;
      font-size: 15px;
      font-weight: bold;
    }
    .primary { background: #166534; color: white; }
    .secondary { background: #e2e8f0; color: #1e293b; }
    .item {
      border: 1px solid #e2e8f0;
      padding: 14px;
      border-radius: 8px;
      margin-top: 12px;
    }
    .ok { color: #166534; }
    .pendente { color: #b45309; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
    }
    .aviso { color: #64748b; font-size: 13px; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>📦 Auditoria RDC-SP2</h1>
      <p>Registro e acompanhamento das auditorias operacionais</p>
    </header>

    <section class="card">
      <h2>Nova auditoria</h2>
      <form id="formulario">
        <div class="grid">
          <div>
            <label for="data">Data</label>
            <input type="date" id="data" required>
          </div>
          <div>
            <label for="responsavel">Responsável</label>
            <input id="responsavel" placeholder="Nome do auditor" required>
          </div>
          <div>
            <label for="area">Área auditada</label>
            <select id="area" required>
              <option value="">Selecione</option>
              <option>Esteira SP2</option>
              <option>Esteira SP9</option>
              <option>Consolidação</option>
              <option>Expedição</option>
              <option>Chegada</option>
              <option>Avarias</option>
              <option>Devolução</option>
              <option>Pacotes perdidos</option>
              <option>Operação geral</option>
            </select>
          </div>
          <div>
            <label for="status">Resultado</label>
            <select id="status" required>
              <option value="">Selecione</option>
              <option>Conforme</option>
              <option>Não conforme</option>
              <option>Em andamento</option>
            </select>
          </div>
        </div>

        <label for="observacao">Observações / não conformidades</label>
        <textarea id="observacao" placeholder="Descreva o que foi identificado..."></textarea>

        <label for="acao">Ação corretiva</label>
        <textarea id="acao" placeholder="Informe a ação necessária..."></textarea>

        <button class="primary" type="submit">Salvar auditoria</button>
      </form>
    </section>

    <section class="card">
      <h2>📋 Auditorias registradas</h2>
      <p id="resumo">Nenhuma auditoria registrada.</p>
      <div id="lista"></div>
      <button class="secondary" id="exportar" type="button">Exportar CSV</button>
      <p class="aviso">Os registros ficam salvos neste navegador. Este protótipo ainda não sincroniza dados entre computadores.</p>
    </section>
  </div>

  <script>
    const chave = "auditoria-rdc-sp2-v1";
    let auditorias = [];

    try {
      auditorias = JSON.parse(localStorage.getItem(chave) || "[]");
    } catch (e) {
      auditorias = [];
    }

    document.getElementById("data").value =
      new Date().toLocaleDateString("en-CA");

    function salvarDados() {
      localStorage.setItem(chave, JSON.stringify(auditorias));
      mostrarAuditorias();
    }

    function mostrarAuditorias() {
      const lista = document.getElementById("lista");
      const resumo = document.getElementById("resumo");
      lista.replaceChildren();

      const conformes = auditorias.filter(a => a.status === "Conforme").length;
      resumo.textContent =
        auditorias.length + " auditoria(s) registrada(s) • " +
        conformes + " conforme(s)";

      [...auditorias].reverse().forEach((a, indice) => {
        const item = document.createElement("div");
        item.className = "item";

        const titulo = document.createElement("strong");
        titulo.textContent = a.area + " — " + a.data;
        item.appendChild(titulo);

        const detalhes = document.createElement("p");
        detalhes.textContent =
          "Responsável: " + a.responsavel + " | Resultado: " + a.status;
        item.appendChild(detalhes);

        const obs = document.createElement("p");
        obs.textContent = "Observações: " + (a.observacao || "Nenhuma");
        item.appendChild(obs);

        const acao = document.createElement("p");
        acao.textContent = "Ação corretiva: " + (a.acao || "Nenhuma");
        item.appendChild(acao);

        const excluir = document.createElement("button");
        excluir.className = "secondary";
        excluir.textContent = "Excluir registro";
        excluir.type = "button";
        excluir.addEventListener("click", () => {
          if (confirm("Deseja excluir esta auditoria?")) {
            auditorias.splice(auditorias.length - 1 - indice, 1);
            salvarDados();
          }
        });
        item.appendChild(excluir);
        lista.appendChild(item);
      });
    }

    document.getElementById("formulario").addEventListener("submit", e => {
      e.preventDefault();

      auditorias.push({
        data: document.getElementById("data").value,
        responsavel: document.getElementById("responsavel").value.trim(),
        area: document.getElementById("area").value,
        status: document.getElementById("status").value,
        observacao: document.getElementById("observacao").value.trim(),
        acao: document.getElementById("acao").value.trim()
      });

      salvarDados();
      e.target.reset();
      document.getElementById("data").value =
        new Date().toLocaleDateString("en-CA");
      alert("Auditoria salva neste navegador!");
    });

    document.getElementById("exportar").addEventListener("click", () => {
      const colunas = ["Data", "Responsável", "Área", "Resultado",
                       "Observações", "Ação corretiva"];
      const linhas = auditorias.map(a => [
        a.data, a.responsavel, a.area, a.status, a.observacao, a.acao
      ]);

      const csv = [colunas, ...linhas]
        .map(linha => linha.map(v =>
          '"' + String(v ?? "").replace(/"/g, '""') + '"'
        ).join(";"))
        .join("\r\n");

      const arquivo = new Blob(["\uFEFF" + csv],
        { type: "text/csv;charset=utf-8;" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(arquivo);
      link.download = "auditoria-rdc-sp2.csv";
      link.click();
      URL.revokeObjectURL(link.href);
    });

    mostrarAuditorias();
  </script>
</body>
</html>
